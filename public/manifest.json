{
  "manifest_version": 3,
  "name": "Earmark — Lecture Notes",
  "short_name": "Earmark",
  "version": "0.1.0",
  "description": "Record a tab’s audio, get a live transcript and AI study notes, organised into projects.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Earmark",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabCapture",
    "offscreen",
    "tabs",
    "contextMenus",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording the current tab"
    }
  }
}
